/*
 * cnv-controlfreec-batch: default configuration
 */

manifest {
    name            = 'bioinfosourabh/cnv-controlfreec-batch'
    contributors    = [
        [
            name        : 'Sourabh Kumar',
            email       : 'bioinfosourabh@gmail.com',
            github      : 'bioinfosourabh',
            orcid       : 'https://orcid.org/0009-0009-5840-9830',
            contribution: ['author', 'maintainer']
        ]
    ]
    homePage        = 'https://github.com/bioinfosourabh/cnv-controlfreec-batch'
    description     = 'Control-FREEC copy-number calling for many samples from one sample sheet'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.10.0'
    version         = '1.0.0'
    license         = 'MIT'
}

params {
    input            = null
    outdir           = null
    publish_dir_mode = 'copy'

    // Reference
    fasta            = null
    fasta_fai        = null
    chr_len          = null
    chr_files        = null
    contig_regex     = '^(chr)?([0-9]+|X|Y)$'
    capture_bed      = null
    snp_vcf          = null
    mappability      = null

    // Control-FREEC
    template         = "${projectDir}/assets/config_template.txt"
    freec_set        = null
    freec_threads    = 4
    freec_container  = 'quay.io/biocontainers/control-freec:11.6b--hde5307d_3'

    // Post-processing
    run_significance = true
    run_plots        = true
    run_export       = true
    alpha            = 0.05
    skip_multiqc     = false
    save_reference   = false

    // AWS Batch
    awsqueue         = null
    awsregion        = 'eu-west-2'
    awscli           = null
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        apptainer.enabled      = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
    }
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = params.awsqueue
        aws.region             = params.awsregion
        aws.batch.cliPath      = params.awscli
        docker.enabled         = true
    }
    test {
        includeConfig 'conf/test.config'
    }
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = '/.Rprofile'
    R_ENVIRON_USER   = '/.Renviron'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
