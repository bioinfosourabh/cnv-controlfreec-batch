/*
 * Simulated data: one tumour-normal pair and one tumour-only sample on a
 * two-contig genome with a known gain and loss (tests/data/truth_cnv.tsv).
 *
 *   nextflow run . -profile test,docker --outdir results_test
 */
params {
    input          = "${projectDir}/assets/samplesheet_test.csv"
    outdir         = 'results_test'
    fasta          = "${projectDir}/tests/data/genome.fasta"
    snp_vcf        = "${projectDir}/tests/data/snps.vcf.gz"
    // whole-genome mode with 5 kb windows on the 400 kb test genome
    freec_set      = 'WINDOW=5000,CONTAMINATION=0'
    freec_threads  = 2
}

process {
    resourceLimits = [cpus: 2, memory: 6.GB, time: 1.h]
}
